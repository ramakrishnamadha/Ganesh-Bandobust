generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(cuid())
  employeeId            String   @unique
  username              String   @unique
  passwordHash          String
  name                  String
  rank                  String
  phoneNumber           String?
  team                  String?
  role                  String
  accessLevel           Int
  mustChangePassword    Boolean  @default(true)
  commissionerateCode   String?
  commissionerateName   String?
  rangeCode             String?
  rangeName             String?
  zoneCode              String?
  zoneName              String?
  divisionCode          String?
  divisionName          String?
  policeStationCode     String?
  policeStationName     String?
  sectorCode            String?
  sectorName            String?
  allPoliceStations     Boolean  @default(false)
  allDivisions          Boolean  @default(false)
  allZones              Boolean  @default(false)
  allRanges             Boolean  @default(false)
  status                String   @default("ACTIVE")
  lastPasswordChangedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  policeStationAccesses UserPoliceStationAccess[]

  @@index([employeeId])
  @@index([username])
  @@index([role])
  @@index([accessLevel])
  @@index([rangeCode])
  @@index([zoneCode])
  @@index([divisionCode])
  @@index([policeStationCode])
  @@index([sectorCode])
  @@index([status])
}

model UserPoliceStationAccess {
  id                String   @id @default(cuid())
  userId            String
  policeStationCode String?
  policeStationName String
  canView           Boolean  @default(true)
  canEdit           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, policeStationName])
  @@index([userId])
  @@index([policeStationCode])
  @@index([policeStationName])
}

model PreInstallationVerification {
  id                        Int      @id @default(autoincrement())
  gpid                      String   @unique
  applicationId             String?
  locationResult            Json?
  mandapResult              Json?
  idolResult                Json?
  routeResult               Json?
  securityResult            Json?
  organizerResult           Json?
  interDepartmentalResult   Json?
  permissionShoReviewResult Json?
  verificationStatus        String   @default("COMPLETED")
  submittedAt               DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model UserSession {
  id                  String    @id @default(cuid())
  userId              String
  userName            String?
  rank                String?
  role                String?
  source              String
  commissionerateCode String?
  rangeCode           String?
  zoneCode            String?
  divisionCode        String?
  policeStationCode   String?
  sectorCode          String?
  status              String    @default("ACTIVE")
  loginAt             DateTime  @default(now())
  logoutAt            DateTime?
  lastSeenAt          DateTime  @default(now())

  deviceSessions DeviceSession[]
  activityEvents ActivityEvent[]

  @@index([userId])
  @@index([status])
  @@index([policeStationCode])
  @@index([sectorCode])
  @@index([lastSeenAt])
}

model DeviceSession {
  id              String    @id @default(cuid())
  userSessionId   String
  userId           String
  deviceType       String
  deviceId         String?
  deviceName       String?
  manufacturer     String?
  model            String?
  platform         String?
  osVersion        String?
  appVersion       String?
  trackingStatus   String    @default("TRACKING_STOPPED")
  trackingEnabled  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  endedAt          DateTime?

  userSession     UserSession              @relation(fields: [userSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currentLocation OfficerCurrentLocation?
  locationHistory OfficerLocationHistory[]
  activityEvents  ActivityEvent[]

  @@index([userSessionId])
  @@index([userId])
  @@index([deviceType])
  @@index([trackingStatus])
  @@index([lastSeenAt])
}

model OfficerCurrentLocation {
  id              String   @id @default(cuid())
  deviceSessionId String   @unique
  userId           String
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  batteryLevel     Int?
  locationSource   String
  activityStatus   String?
  activeGpid       String?
  capturedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deviceSession DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([capturedAt])
  @@index([activityStatus])
  @@index([activeGpid])
}

model OfficerLocationHistory {
  id              String   @id @default(cuid())
  deviceSessionId String
  userId           String
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  batteryLevel     Int?
  locationSource   String
  eventType        String   @default("HEARTBEAT")
  activeGpid       String?
  capturedAt       DateTime
  receivedAt       DateTime @default(now())

  deviceSession DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([deviceSessionId, capturedAt])
  @@index([userId, capturedAt])
  @@index([eventType])
  @@index([activeGpid])
}

model ActivityEvent {
  id                  String   @id @default(cuid())
  userId              String
  userSessionId       String?
  deviceSessionId     String?
  source              String
  eventType           String
  gpid                String?
  applicationId       String?
  commissionerateCode String?
  rangeCode           String?
  zoneCode            String?
  divisionCode        String?
  policeStationCode   String?
  sectorCode          String?
  latitude            Float?
  longitude           Float?
  accuracy            Float?
  oldValue            Json?
  newValue            Json?
  metadata            Json?
  occurredAt          DateTime
  createdAt           DateTime @default(now())

  userSession   UserSession?   @relation(fields: [userSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deviceSession DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, occurredAt])
  @@index([eventType])
  @@index([gpid, occurredAt])
  @@index([policeStationCode])
  @@index([sectorCode])
  @@index([createdAt])
}